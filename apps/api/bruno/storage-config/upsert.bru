meta {
  name: Upsert Storage Config
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/storage-config
  body: json
  auth: inherit
}

body:json {
  {
    "enabled": true,
    "protocol": "ftp",
    "host": "192.168.1.254",
    "port": 21,
    "secure": false,
    "moviePath": "Movies",
    "tvPath": "TV Shows",
    "username": "admin",
    "password": "secret",
    "deleteLocalAfterTransfer": false
  }
}

docs {
  Requires admin role or higher. Upserts the single remote storage configuration (FTP or WebDAV). Omit password to keep the existing one.
}
