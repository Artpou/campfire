{
  "name": "@seedarr/api",
  "version": "1.0.0",
  "private": true,
  "main": "./src/app.ts",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./src/app.ts"
    },
    "./types/inputs": {
      "types": "./dist/types/inputs.d.ts",
      "default": "./src/types/inputs.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./src/types.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --include 'src/**' src/server.ts",
    "tsc": "tsc",
    "build": "tsc",
    "start": "node --loader tsx src/server.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "test": "vitest run",
    "format": "biome format --write .",
    "db:generate": "dotenvx run -f ../../.env -- drizzle-kit generate",
    "db:migrate": "dotenvx run -f ../../.env -- drizzle-kit migrate",
    "db:push": "dotenvx run -f ../../.env -- drizzle-kit push",
    "db:studio": "dotenvx run -f ../../.env -- drizzle-kit studio",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ctrl/video-filename-parser": "^5.11.0",
    "@dotenvx/dotenvx": "^1.38.0",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.4.1",
    "@libsql/client": "^0.15.15",
    "@seedarr/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.6.0",
    "fluent-ffmpeg": "^2.1.3",
    "hono": "catalog:",
    "hono-rate-limiter": "^0.5.3",
    "iconv-lite": "^0.7.1",
    "ms": "catalog:",
    "unzipper": "^0.12.3",
    "webtorrent": "2.8.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/ms": "catalog:",
    "@types/node": "catalog:",
    "@types/webtorrent": "^0.110.1",
    "better-sqlite3": "^12.10.0",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "^4.1.8"
  }
}
