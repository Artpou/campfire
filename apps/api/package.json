{
  "name": "@seedarr/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --include 'src/**' src/server.ts",
    "build": "tsup",
    "build:types": "tsc -p tsconfig.types.json",
    "start": "node dist-server/server.mjs",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "biome format --write .",
    "db:generate": "dotenvx run -f ../../.env -- drizzle-kit generate",
    "db:migrate": "dotenvx run -f ../../.env -- drizzle-kit migrate",
    "db:migrate:prod": "node docker-migrate.mjs",
    "db:push": "dotenvx run -f ../../.env -- drizzle-kit push",
    "db:studio": "dotenvx run -f ../../.env -- drizzle-kit studio"
  },
  "dependencies": {
    "@ctrl/video-filename-parser": "^5.11.0",
    "@dotenvx/dotenvx": "^1.38.0",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.8.0",
    "@libsql/client": "^0.15.15",
    "@seedarr/contracts": "workspace:*",
    "@seedarr/shared": "workspace:*",
    "basic-ftp": "^6.0.1",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "fast-xml-parser": "^5.10.1",
    "hono": "catalog:",
    "hono-rate-limiter": "^0.5.3",
    "iconv-lite": "^0.7.1",
    "lru-cache": "^11.5.2",
    "ms": "catalog:",
    "unzipper": "^0.12.3",
    "webdav": "^5.10.0",
    "webtorrent": "2.8.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@seedarr/typescript-config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ms": "catalog:",
    "@types/node": "catalog:",
    "@types/webtorrent": "^0.110.1",
    "@vitest/coverage-v8": "catalog:",
    "better-sqlite3": "^12.10.0",
    "drizzle-kit": "^0.31.8",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
