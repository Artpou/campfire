meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Cookie:
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  const jar = bru.cookies.jar();
  jar.getCookie("{{baseUrl}}", "session", function(err, cookie) {
    if (cookie?.value) {
      bru.setEnvVar("sessionToken", cookie.value);
    }
  });
}
