meta {
  name: Update Config
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/plex/config
  body: json
  auth: inherit
}

body:json {
  {
    "hostname": "localhost",
    "port": 32400,
    "token": "your-plex-token",
    "serverName": "My Plex Server",
    "machineIdentifier": "",
    "useSsl": false,
    "syncMovies": true,
    "syncTv": true,
    "syncDownloads": false
  }
}

docs {
  Requires admin role or higher.
}
