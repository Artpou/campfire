{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["scripts/*"],
  "ignoreDependencies": ["@lingui/swc-plugin"],
  "tags": ["-lintignore"],
  "rules": {
    "types": "warn"
  },
  "workspaces": {
    ".": {},
    "apps/web": {
      "ignore": ["src/shared/ui/*.tsx", "lingui.config.ts"]
    },
    "apps/api": {
      "ignoreBinaries": ["ffmpeg", "ffprobe"],
      "ignore": [
        "src/modules/tmdb/tmdb.types.ts",
        "src/modules/subtitle/subtitle.types.ts",
        "src/modules/torrent/torrent.types.ts"
      ]
    },
    "apps/website": {
      "entry": ["src/**/*.{ts,tsx,astro,md,mdx}"]
    },
    "packages/contracts": {},
    "packages/sdk": {},
    "packages/shared": {},
    "packages/typescript-config": {
      "entry": ["*.json"]
    }
  }
}
