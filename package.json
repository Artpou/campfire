{
  "name": "seedarr",
  "version": "0.1.0-beta.0",
  "private": true,
  "scripts": {
    "build:types": "pnpm --filter @seedarr/api build && pnpm --filter @seedarr/sdk build",
    "dev": "pnpm build:types && turbo dev dev:types db:studio",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "biome check --write --unsafe .",
    "tsc": "turbo tsc",
    "test": "turbo test",
    "knip": "knip",
    "check": "turbo lint tsc test //#knip",
    "format": "biome format --write .",
    "db:generate": "turbo db:generate",
    "db:migrate": "pnpm --filter @seedarr/api db:migrate",
    "db:push": "pnpm --filter @seedarr/api db:push",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "knip": "^6.16.1",
    "lint-staged": "^16.2.6",
    "turbo": "^2.9.18",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ],
    "*.{json,md}": [
      "biome format --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ]
  }
}
