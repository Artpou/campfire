{
  "name": "seedarr",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web,studio -c blue,magenta,green \"pnpm --filter @seedarr/api dev\" \"pnpm --filter web dev\" \"pnpm --filter @seedarr/api db:studio\"",
    "dev:api": "pnpm --filter @seedarr/api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter @seedarr/api build && pnpm --filter web build",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "tsc": "pnpm --filter @seedarr/api build && pnpm -r tsc",
    "test": "pnpm --filter @seedarr/api test",
    "check": "pnpm run lint:fix && pnpm run tsc && pnpm run lint && pnpm run test",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @seedarr/api db:generate",
    "db:migrate": "pnpm --filter @seedarr/api db:migrate",
    "db:push": "pnpm --filter @seedarr/api db:push",
    "db:studio": "pnpm --filter @seedarr/api db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "concurrently": "^10.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6"
  },
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ],
    "*.{json,md}": [
      "biome format --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ]
  }
}
