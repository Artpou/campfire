{
  "name": "seedarr",
  "version": "0.2.3",
  "private": true,
  "scripts": {
    "dev": "turbo watch build:types check-types dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "biome check --write --unsafe .",
    "check-types": "turbo run check-types",
    "build:types": "turbo run build:types",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "knip": "knip",
    "check": "turbo run lint check-types test //#knip",
    "format": "biome format --write .",
    "db:studio": "pnpm --filter @seedarr/api db:studio",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @seedarr/api db:migrate",
    "db:push": "pnpm --filter @seedarr/api db:push",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "knip": "^6.16.1",
    "lint-staged": "^16.2.6",
    "turbo": "^2.9.18",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ],
    "*.{json,md}": [
      "biome format --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ]
  }
}
