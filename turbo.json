{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "db:generate": {
      "cache": true,
      "outputs": ["src/db/drizzle/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-server/**"]
    },
    "@seedarr/api#build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist-server/**"]
    },
    "build:types": {
      "dependsOn": ["^build:types"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "tsc": {
      "dependsOn": ["^build:types"],
      "outputs": []
    },
    "lint": { "outputs": [] },
    "lint:fix": { "outputs": [] },
    "test": { "outputs": [] },
    "//#knip": { "cache": false }
  }
}
