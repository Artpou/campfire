{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "dist-server/**"]
    },
    "@seedarr/api#build": {
      "dependsOn": ["^build", "db:generate", "build:types"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist-server/**"]
    },
    "build:types": {
      "dependsOn": ["^build:types"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["topo", "^build:types", "^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": true,
      "outputs": ["src/db/drizzle/**"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["topo"]
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["topo"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["topo"],
      "outputs": ["coverage/**"]
    },
    "//#knip": {
      "cache": false
    }
  }
}
