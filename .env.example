# Database (SQLite via libSQL)
DATABASE_URL=file:./dev.db

# API
API_PORT=3002
API_URL=http://localhost
NODE_ENV=development
WEB_URL=http://localhost:3000

## Logging (debug | info | warn | error | silent)
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=./seedarr.log

## PUBLIC API KEYS (you can change them if you want)
SUBDL_API_KEY=Ae8t-PLGROMrTitTPJGfOye7Z17RWaVN
TMDB_API_KEY=29f788393063cd24bfb885d7d6ee9ae4

# Frontend (dev only — production uses same-origin)
VITE_API_URL=http://localhost:3002

# Downloads
DOWNLOADS_PATH=./downloads
RESUME_DOWNLOADS=false
SEED_AFTER_COMPLETE_MINUTES=5

# Remote storage (FTP/WebDAV) — required to encrypt credentials at rest in production.
# Use a long random secret. Keep it stable across restarts.
# Dev/test fall back to an insecure default if unset.
STORAGE_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Reverse proxy trust for client IP (rate limiting). Comma-separated proxy-addr compile list.
# Default trusts loopback/link-local/unique-local so X-Forwarded-For is only used behind a local proxy.
# TRUST_PROXY=loopback,linklocal,uniquelocal
